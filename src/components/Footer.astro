---
import { strings, X_URL, type Lang } from "../i18n/strings";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = strings[lang];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <p class="footer__giant mono" aria-hidden="true">aigralys<span class="footer__cursor"></span></p>
    <p class="footer__tagline mono muted">{t.footer.tagline}</p>

    <nav class="footer__links mono" aria-label="Footer">
      <a href="#casos">{t.nav.cases}</a>
      <a href="#contacto">{t.nav.contact}</a>
      <a class="footer__social" href={X_URL} target="_blank" rel="me noopener" aria-label={t.footer.followX}>
        <svg class="footer__x" viewBox="0 0 24 24" aria-hidden="true" focusable="false"
          ><path
            fill="currentColor"
            d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
          ></path></svg
        ><span>@aigralys</span>
      </a>
      <a href="#main">{t.footer.backToTop}</a>
    </nav>

    <p class="footer__legal mono muted">
      © {year} aigralys · {t.footer.rights}
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding-block: clamp(4rem, 12vh, 7rem) clamp(2rem, 5vh, 3rem);
    overflow: hidden;
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .footer__giant {
    font-weight: 700;
    font-size: clamp(3.6rem, 17.5vw, 15rem);
    line-height: 0.85;
    letter-spacing: -0.07em;
    color: var(--ink);
    display: flex;
    align-items: flex-end;
    margin-bottom: 0.5rem;
  }

  .footer__cursor {
    flex: none;
    display: inline-block;
    width: 0.5em;
    height: 0.72em;
    margin-left: 0.04em;
    margin-bottom: 0.02em;
    background: var(--gold);
    box-shadow: 0 0 60px 6px rgba(226, 172, 85, 0.35);
    animation: blink 1.05s step-end infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .footer__cursor {
      animation: none;
    }
  }

  .footer__tagline {
    font-size: 0.85rem;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-size: 0.88rem;
  }
  .footer__links a {
    color: var(--slate);
    transition: color 0.15s ease;
  }
  .footer__links a:hover {
    color: var(--gold);
  }

  .footer__social {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }
  .footer__x {
    width: 0.85em;
    height: 0.85em;
    display: block;
    flex: none;
  }

  .footer__legal {
    font-size: 0.78rem;
  }
</style>
