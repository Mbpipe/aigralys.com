---
import { strings, type Lang } from "../i18n/strings";
import Words from "./Words.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = strings[lang];
const [bancor, ...rest] = t.cases.items;
const views = ["dia", "atardecer", "noche"] as const;
const story = [
  { label: t.cases.labels.problem, text: bancor.problem },
  { label: t.cases.labels.ai, text: bancor.ai },
  { label: t.cases.labels.result, text: bancor.result },
];

// Visual de Bitewave: señal de vibración → eventos → notas MIDI (determinístico).
const W = 800;
const H = 450;
let seed = 7;
const rand = () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};
const bursts = [140, 330, 470, 640];
const mid = 130;
const pts: string[] = [];
for (let x = 0; x <= W; x += 4) {
  let amp = 6 + rand() * 6;
  for (const b of bursts) {
    const d = Math.abs(x - b);
    if (d < 40) amp += (1 - d / 40) * 85;
  }
  const y = mid + Math.sin(x * 0.55) * amp * (0.6 + rand() * 0.4);
  pts.push(`${x},${y.toFixed(1)}`);
}
const wave = pts.join(" ");
const rows = 8;
const rollTop = 270;
const rowH = 18;
const notes = bursts.flatMap((b, i) => [
  { x: b - 10, w: 70 + i * 8, r: (i * 3) % rows, d: i },
  { x: b + 20, w: 44, r: (i * 3 + 2) % rows, d: i + 0.3 },
  { x: b + 60, w: 28, r: (i * 3 + 5) % rows, d: i + 0.6 },
]);
const labels =
  lang === "es"
    ? { wave: "vibración", events: "eventos", midi: "notas midi" }
    : { wave: "vibration", events: "events", midi: "midi notes" };
---

<section class="cases-sec" id="casos" aria-labelledby="casos-title">
  <div class="container">
    <Words text={t.cases.heading} class="section__title" id="casos-title" />
    <p class="section__intro">{t.cases.intro}</p>
  </div>

  <!-- Bancor Arena: el scroll lleva el render del día a la noche. -->
  <article class="scrolly" aria-labelledby="case-bancor" data-scrolly>
    <div class="scrolly__sticky">
      <div class="scrolly__media">
        {
          views.map((v, i) => (
            <img
              class="scrolly__img"
              data-view={v}
              src={`/work/bancor-${v}.webp`}
              alt={i === 2 ? `Bancor Arena, render ${t.cases.views[v]}` : ""}
              width="1800"
              height="1013"
              loading="lazy"
              decoding="async"
            />
          ))
        }
      </div>

      <div class="container scrolly__ui">
        <header class="scrolly__head">
          <span class="scrolly__kind mono">{bancor.kind}</span>
          <h3 class="scrolly__name" id="case-bancor">{bancor.name}</h3>
          <ul class="scrolly__tags" role="list">{bancor.tags.map((g) => <li class="tag">{g}</li>)}</ul>
        </header>

        <div class="scrolly__story">
          {
            story.map((s, i) => (
              <div class="scrolly__step" data-step={i}>
                <p class="scrolly__label mono">{s.label}</p>
                <p class="scrolly__text">{s.text}</p>
                {i === 2 && bancor.href && (
                  <a class="case__link mono" href={bancor.href} target="_blank" rel="noopener">
                    {bancor.hrefLabel}
                  </a>
                )}
              </div>
            ))
          }
        </div>

        <div class="scrolly__meter mono" aria-hidden="true">
          {views.map((v) => <span data-meter={v}>{t.cases.views[v]}</span>)}
          <span class="scrolly__caption">{t.cases.caption}</span>
        </div>
      </div>
    </div>
  </article>

  <!-- Resto de los casos -->
  <div class="container">
    <ul class="cases" role="list">
      {
        rest.map((c, idx) => (
          <li>
            <article class:list={["case", { "case--flip": idx % 2 === 1 }]} aria-labelledby={`case-${c.id}`} data-reveal>
              <div class="case__media" data-tilt>
                <div class="case__frame">
                  {c.shot ? (
                    <img src={c.shot} alt={`${c.name}`} loading="lazy" decoding="async" />
                  ) : (
                    <svg class="signal" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${c.name}: ${labels.wave}, ${labels.events}, ${labels.midi}`}>
                      <text class="signal__label" x="24" y="34">{labels.wave}</text>
                      <polyline class="signal__wave" points={wave} pathLength="1" />
                      {bursts.map((b, i) => (
                        <line class="signal__event" x1={b} x2={b} y1="30" y2={rollTop + rows * rowH} style={`--d:${i}`} />
                      ))}
                      <text class="signal__label" x="24" y={rollTop - 14}>{labels.midi}</text>
                      {Array.from({ length: rows + 1 }, (_, r) => (
                        <line class="signal__grid" x1="0" x2={W} y1={rollTop + r * rowH} y2={rollTop + r * rowH} />
                      ))}
                      {notes.map((n) => (
                        <rect class="signal__note" x={n.x} y={rollTop + n.r * rowH + 3} width={n.w} height={rowH - 6} rx="2" style={`--d:${n.d}`} />
                      ))}
                      <text class="signal__label signal__label--gold" x={bursts[0] + 8} y="58">{labels.events}</text>
                      <line class="signal__playhead" x1="0" x2="0" y1="20" y2={rollTop + rows * rowH + 10} />
                    </svg>
                  )}
                </div>
              </div>
              <div class="case__body">
                <span class="case__num mono">{String(idx + 2).padStart(2, "0")} / {String(t.cases.items.length).padStart(2, "0")}</span>
                <div class="case__head">
                  <h3 class="case__name" id={`case-${c.id}`}>{c.name}</h3>
                  <span class="case__kind mono">{c.kind}</span>
                </div>
                <p class="case__problem">{c.problem}</p>
                <p class="case__ai">{c.ai}</p>
                <p class="case__result">{c.result}</p>
                <ul class="case__tags" role="list">{c.tags.map((g) => <li class="tag">{g}</li>)}</ul>
                {c.href && (
                  <a class="case__link mono" href={c.href} target="_blank" rel="noopener">{c.hrefLabel}</a>
                )}
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  const motion = !matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ---------- Bancor: progreso de scroll → día, atardecer, noche ----------
  const scrolly = document.querySelector<HTMLElement>("[data-scrolly]");
  if (scrolly && motion) {
    document.documentElement.classList.add("has-scrolly");
    const imgs = scrolly.querySelectorAll<HTMLImageElement>("[data-view]");
    imgs.forEach((i) => (i.loading = "eager"));
    const steps = scrolly.querySelectorAll<HTMLElement>("[data-step]");
    const meters = scrolly.querySelectorAll<HTMLElement>("[data-meter]");
    const smooth = (a: number, b: number, x: number) => {
      const k = Math.min(1, Math.max(0, (x - a) / (b - a)));
      return k * k * (3 - 2 * k);
    };
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = scrolly.getBoundingClientRect();
      const total = r.height - innerHeight;
      const p = Math.min(1, Math.max(0, -r.top / total));
      scrolly.style.setProperty("--p", p.toFixed(4));
      imgs[1].style.opacity = String(smooth(0.22, 0.42, p));
      imgs[2].style.opacity = String(smooth(0.55, 0.75, p));
      const idx = p < 0.36 ? 0 : p < 0.68 ? 1 : 2;
      steps.forEach((s, i) => s.classList.toggle("is-active", i === idx));
      meters.forEach((m, i) => m.classList.toggle("is-active", i === idx));
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", onScroll);
    update();
  }

  // ---------- Inclinación de las capturas con el puntero ----------
  if (motion && matchMedia("(hover: hover)").matches) {
    for (const el of document.querySelectorAll<HTMLElement>("[data-tilt]")) {
      el.addEventListener("pointermove", (e) => {
        const r = el.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        el.style.setProperty("--rx", `${(-y * 7).toFixed(2)}deg`);
        el.style.setProperty("--ry", `${(x * 9).toFixed(2)}deg`);
        el.style.setProperty("--mx", `${((x + 0.5) * 100).toFixed(1)}%`);
        el.style.setProperty("--my", `${((y + 0.5) * 100).toFixed(1)}%`);
      });
      el.addEventListener("pointerleave", () => {
        el.style.setProperty("--rx", "0deg");
        el.style.setProperty("--ry", "0deg");
      });
    }
  }
</script>

<style>
  .cases-sec {
    padding-block: clamp(4rem, 10vh, 7rem) clamp(3rem, 8vh, 5rem);
    border-top: 1px solid var(--border);
  }

  /* =========== scrolly Bancor =========== */
  /* Sin JS o con movimiento reducido: bloque estático. */
  .scrolly {
    position: relative;
    margin-top: clamp(2.5rem, 6vh, 4rem);
  }
  .scrolly__sticky {
    position: relative;
  }
  .scrolly__media {
    position: relative;
    aspect-ratio: 1800 / 1013;
    max-height: 80svh;
    width: 100%;
    overflow: hidden;
    background: var(--void);
  }
  .scrolly__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .scrolly__img[data-view="dia"],
  .scrolly__img[data-view="atardecer"] {
    opacity: 0;
  }
  .scrolly__ui {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-top: 1.5rem;
  }
  .scrolly__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
  }
  .scrolly__kind {
    font-size: 0.8rem;
    color: var(--gold);
    flex-basis: 100%;
  }
  .scrolly__name {
    font-family: var(--mono);
    font-weight: 700;
    font-size: clamp(2rem, 6vw, 4.4rem);
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--ink);
  }
  .scrolly__tags :global(.tag) {
    background: rgba(6, 12, 23, 0.7);
    color: #A9B5C4;
  }
  .scrolly__tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .scrolly__story {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 860px) {
    .scrolly__story {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .scrolly__label {
    font-size: 0.82rem;
    color: var(--gold);
    margin-bottom: 0.35rem;
  }
  .scrolly__text {
    color: var(--ink);
  }
  .scrolly__meter {
    display: none;
  }

  /* Con JS y movimiento: sección alta con escena fija. */
  :global(.has-scrolly) .scrolly {
    height: 340svh;
  }
  :global(.has-scrolly) .scrolly__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }
  :global(.has-scrolly) .scrolly__media {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
    max-height: none;
  }
  :global(.has-scrolly) .scrolly__img[data-view="dia"] {
    opacity: 1;
  }
  :global(.has-scrolly) .scrolly__img {
    transform: scale(calc(1.18 - var(--p, 0) * 0.18));
    transform-origin: 55% 60%;
    will-change: transform, opacity;
  }
  :global(.has-scrolly) .scrolly__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(6, 12, 23, 0.82) 0%, rgba(6, 12, 23, 0.3) 45%, rgba(6, 12, 23, 0) 68%),
      linear-gradient(to top, rgba(6, 12, 23, 0.85) 0%, rgba(6, 12, 23, 0) 40%);
  }
  :global(.has-scrolly) .scrolly__ui {
    position: relative;
    height: 100%;
    justify-content: space-between;
    padding-block: clamp(5.5rem, 14vh, 7rem) clamp(1.5rem, 5vh, 2.5rem);
  }
  :global(.has-scrolly) .scrolly__story {
    display: block;
    position: relative;
    flex: 1;
    max-width: 30rem;
    margin-top: 2rem;
  }
  :global(.has-scrolly) .scrolly__step {
    position: absolute;
    inset: 0 0 auto 0;
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.6s var(--ease-out);
    pointer-events: none;
  }
  :global(.has-scrolly) .scrolly__step.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  :global(.has-scrolly) .scrolly__text {
    font-size: clamp(1.15rem, 2.4vw, 1.6rem);
    line-height: 1.45;
  }
  :global(.has-scrolly) .scrolly__meter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.25rem;
    font-size: 0.8rem;
    color: var(--slate);
  }
  .scrolly__meter [data-meter] {
    position: relative;
    padding-top: 0.6rem;
    transition: color 0.3s ease;
  }
  .scrolly__meter [data-meter]::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 3.5rem;
    height: 2px;
    background: var(--border);
    transition: background-color 0.3s ease;
  }
  .scrolly__meter [data-meter].is-active {
    color: var(--ink);
  }
  .scrolly__meter [data-meter].is-active::before {
    background: var(--gold);
    box-shadow: 0 0 12px rgba(226, 172, 85, 0.7);
  }
  .scrolly__caption {
    margin-left: auto;
  }
  @media (max-width: 640px) {
    .scrolly__caption {
      display: none;
    }
  }

  /* =========== otros casos =========== */
  .case__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.9rem;
  }
  .case__name {
    font-family: var(--mono);
    font-size: clamp(1.6rem, 3.6vw, 2.4rem);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.04em;
  }
  .case__kind {
    font-size: 0.8rem;
    color: var(--slate);
  }
  .case__num {
    font-size: 0.8rem;
    color: var(--gold);
  }
  .case__tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .case__link {
    display: inline-block;
    align-self: flex-start;
    margin-top: 0.6rem;
    font-size: 0.88rem;
    color: var(--gold);
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  .case__link:hover {
    color: var(--ink);
  }

  .cases {
    list-style: none;
    padding: 0;
    margin-top: clamp(3rem, 8vh, 5rem);
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 9vh, 6rem);
  }

  .case {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
  }
  @media (min-width: 860px) {
    .case {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2rem, 5vw, 4rem);
      align-items: center;
    }
    .case--flip .case__media {
      order: 2;
    }
  }

  .case__media {
    perspective: 1200px;
  }
  .case__frame {
    position: relative;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--panel);
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.5s var(--ease-out), border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .case__media:hover .case__frame {
    border-color: rgba(226, 172, 85, 0.5);
    box-shadow: 0 30px 80px -30px rgba(226, 172, 85, 0.35);
  }
  .case__frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), rgba(255, 230, 180, 0.14), transparent 45%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .case__media:hover .case__frame::after {
    opacity: 1;
  }
  .case__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .case__body {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .case__problem {
    color: var(--ink);
    font-size: 1.1rem;
  }
  .case__ai,
  .case__result {
    color: var(--slate);
  }

  /* Revelado al entrar: la captura se abre como una cortina. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .case .case__frame {
      clip-path: inset(0 100% 0 0 round 8px);
      transition:
        clip-path 1.1s var(--ease-out),
        transform 0.5s var(--ease-out),
        border-color 0.3s ease,
        box-shadow 0.3s ease;
    }
    :global(.js) .case--flip .case__frame {
      clip-path: inset(0 0 0 100% round 8px);
    }
    :global(.js) .case.is-in .case__frame {
      clip-path: inset(0 0 0 0 round 8px);
    }
    :global(.js) .case .case__body {
      opacity: 0;
      transform: translateY(20px);
      transition:
        opacity 0.9s var(--ease-out) 0.25s,
        transform 0.9s var(--ease-out) 0.25s;
    }
    :global(.js) .case.is-in .case__body {
      opacity: 1;
      transform: none;
    }

    /* Bitewave: la señal se dibuja y las notas aparecen. */
    :global(.js) .case .signal__wave {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      transition: stroke-dashoffset 2.4s var(--ease-out) 0.5s;
    }
    :global(.js) .case.is-in .signal__wave {
      stroke-dashoffset: 0;
    }
    :global(.js) .case .signal__note,
    :global(.js) .case .signal__event {
      opacity: 0;
      transition: opacity 0.4s ease;
      transition-delay: calc(0.9s + var(--d) * 0.42s);
    }
    :global(.js) .case.is-in .signal__note,
    :global(.js) .case.is-in .signal__event {
      opacity: 1;
    }
  }

  /* ---------- visual bitewave ---------- */
  .signal {
    width: 100%;
    height: 100%;
    display: block;
  }
  .signal__wave {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .signal__event {
    stroke: var(--gold);
    stroke-width: 1;
    stroke-dasharray: 3 4;
  }
  .signal__grid {
    stroke: var(--border);
    stroke-width: 1;
  }
  .signal__note {
    fill: var(--gold);
  }
  .signal__playhead {
    stroke: var(--gold);
    stroke-width: 2;
    opacity: 0;
    filter: drop-shadow(0 0 6px rgba(226, 172, 85, 0.9));
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .case.is-in .signal__playhead {
      opacity: 1;
      animation: sweep 5.5s linear 3.2s infinite both;
    }
  }
  @keyframes sweep {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(800px);
    }
  }
  .signal__label {
    font-family: var(--mono);
    font-size: 15px;
    fill: var(--slate);
  }
  .signal__label--gold {
    fill: var(--gold);
  }
</style>
