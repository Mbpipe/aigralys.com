---
import { strings, type Lang } from "../i18n/strings";
import Words from "./Words.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = strings[lang];
const total = String(t.cases.items.length).padStart(2, "0");
const L = t.cases.labels;

// Posiciones de las trampas de costo sobre la captura de clearlit (en % del cuadro).
const traps = [
  { x: 54, y: 47 },
  { x: 54, y: 64 },
  { x: 54, y: 75 },
];
// Rutas de cobro (anchos relativos del neto), la ganadora resaltada.
const routes = [{ w: 72 }, { w: 88 }, { w: 97, best: true }, { w: 81 }];
const routeLabel = lang === "es" ? "método" : "method";
---

<section class="cases-sec" id="casos" aria-labelledby="casos-title">
  <div class="container cases-intro">
    <Words text={t.cases.heading} class="section__title" id="casos-title" />
    <p class="section__intro">{t.cases.intro}</p>
    <ol class="cases-index mono" role="list">
      {
        t.cases.items.map((c, i) => (
          <li>
            <a href={`#case-${c.id}`}>
              <span class="gold">{String(i + 1).padStart(2, "0")}</span> {c.name}
            </a>
          </li>
        ))
      }
    </ol>
  </div>

  {
    t.cases.items.map((c, i) => (
      <article class="chapter" data-chapter={c.id} data-step="0" aria-labelledby={`case-${c.id}-name`} id={`case-${c.id}`}>
        <div class="chapter__stage">
          <span class="chapter__bignum mono" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <div class="container chapter__grid">
            <div class="chapter__text">
              <p class="chapter__num mono">
                <span><span class="gold">{String(i + 1).padStart(2, "0")}</span> / {total}</span>
                <span>{c.kind}</span>
              </p>
              <h3 class="chapter__name" id={`case-${c.id}-name`}>{c.name}</h3>
              <ul class="chapter__tags" role="list">{c.tags.map((g) => <li class="tag">{g}</li>)}</ul>

              <div class="chapter__story">
                {[
                  [L.problem, c.problem],
                  [L.ai, c.ai],
                  [L.result, c.result],
                ].map(([label, text], s) => (
                  <div class="chapter__step" data-s={s}>
                    <p class="chapter__label mono">{label}</p>
                    <p class="chapter__body">{text}</p>
                  </div>
                ))}
              </div>

              <div class="chapter__foot">
                <div class="chapter__meter" aria-hidden="true">
                  <span data-m="0" /><span data-m="1" /><span data-m="2" />
                </div>
                {c.href && (
                  <a class="chapter__link mono" href={c.href} target="_blank" rel="noopener">{c.hrefLabel}</a>
                )}
              </div>
            </div>

            <div class="chapter__visual">
              <div class={`screen screen--${c.id}`}>
                {c.id === "bancor" &&
                  ["dia", "atardecer", "noche"].map((v) => (
                    <img class="screen__img" data-view={v} src={`/work/bancor-${v}.webp`} alt="" width="1800" height="1013" loading="lazy" decoding="async" />
                  ))}

                {c.id === "clearlit" && (
                  <>
                    <img class="screen__img screen__img--top" src="/work/clearlit.webp" alt="" width="1600" height="900" loading="lazy" decoding="async" />
                    <span class="scan" aria-hidden="true" />
                    {traps.map((p, k) => (
                      <span class="trap" style={`left:${p.x}%;top:${p.y}%;--k:${k}`} aria-hidden="true" />
                    ))}
                    <div class="saving mono" aria-hidden="true">
                      <span class="saving__from">USD 800</span>
                      <span class="saving__arrow">→</span>
                      <span class="saving__to">USD 75</span>
                      <span class="saving__unit">/ {lang === "es" ? "mes" : "mo"}</span>
                    </div>
                  </>
                )}

                {c.id === "comolocobro" && (
                  <>
                    <img class="screen__img screen__img--top screen__img--dim" src="/work/comolocobro.webp" alt="" width="1600" height="900" loading="lazy" decoding="async" />
                    <div class="routes mono" aria-hidden="true">
                      {routes.map((r, k) => (
                        <div class:list={["route", { "route--best": r.best }]} style={`--w:${r.w}%;--k:${k}`}>
                          <span class="route__label">{routeLabel} {String.fromCharCode(65 + k)}</span>
                          <span class="route__bar"><span /></span>
                        </div>
                      ))}
                    </div>
                  </>
                )}

                {c.id === "bitewave" && (
                  <video class="screen__img" src="/work/bitewave-hud.mp4" poster="/work/bitewave-hud.webp" muted loop playsinline preload="none" data-video />
                )}

                <div class="hud mono" aria-hidden="true">
                  <p class="hud__title"><span class="hud__dot" />{t.cases.hudTitle} / {c.id}</p>
                  {c.hud.map((line, s) => (
                    <p class="hud__line" data-h={s}>
                      <span class="hud__mark" />
                      {line}
                    </p>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>
    ))
  }
</section>

<script>
  const motion = !matchMedia("(prefers-reduced-motion: reduce)").matches;
  const chapters = document.querySelectorAll<HTMLElement>("[data-chapter]");

  // Videos: se reproducen solo cuando se ven.
  const vio = new IntersectionObserver((entries) => {
    for (const e of entries) {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting && motion) v.play().catch(() => {});
      else v.pause();
    }
  });
  document.querySelectorAll<HTMLVideoElement>("[data-video]").forEach((v) => {
    v.preload = "auto";
    vio.observe(v);
  });

  if (motion && chapters.length) {
    document.documentElement.classList.add("has-chapters");
    document.querySelectorAll<HTMLImageElement>(".chapter img").forEach((i) => (i.loading = "eager"));
    const smooth = (a: number, b: number, x: number) => {
      const k = Math.min(1, Math.max(0, (x - a) / (b - a)));
      return k * k * (3 - 2 * k);
    };
    let ticking = false;
    const update = () => {
      ticking = false;
      for (const ch of chapters) {
        const r = ch.getBoundingClientRect();
        if (r.bottom < -100 || r.top > innerHeight + 100) continue;
        const total = r.height - innerHeight;
        const p = Math.min(1, Math.max(0, -r.top / total));
        ch.style.setProperty("--p", p.toFixed(4));
        ch.dataset.step = String(p < 0.34 ? 0 : p < 0.67 ? 1 : 2);
        if (ch.dataset.chapter === "bancor") {
          const imgs = ch.querySelectorAll<HTMLImageElement>("[data-view]");
          imgs[1].style.opacity = String(smooth(0.25, 0.45, p));
          imgs[2].style.opacity = String(smooth(0.58, 0.78, p));
        }
      }
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", onScroll);
    update();
  }
</script>

<style>
  .cases-sec {
    padding-top: clamp(4rem, 10vh, 7rem);
    border-top: 1px solid var(--border);
  }

  .cases-index {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cases-index a {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--ink);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }
  .cases-index a:hover {
    border-color: var(--gold);
    background: rgba(226, 172, 85, 0.08);
  }

  /* =========== base estática (sin JS o con movimiento reducido) =========== */
  .chapter {
    position: relative;
    padding-block: clamp(3rem, 8vh, 5rem);
    border-bottom: 1px solid var(--border);
  }
  .chapter:last-of-type {
    border-bottom: 0;
  }

  .chapter__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 960px) {
    .chapter__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(2rem, 4vw, 4rem);
    }
  }

  .chapter__text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .chapter__num {
    font-size: 0.85rem;
    color: var(--slate);
    display: flex;
    gap: 1.25rem;
  }
  .chapter__name {
    font-family: var(--mono);
    font-weight: 700;
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--ink);
  }
  .chapter__tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .chapter__story {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-top: 0.5rem;
  }
  .chapter__label {
    font-size: 0.82rem;
    color: var(--gold);
    margin-bottom: 0.3rem;
  }
  .chapter__body {
    color: var(--ink);
  }
  .chapter__foot {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 0.5rem;
  }
  .chapter__meter {
    display: none;
  }
  .chapter__link {
    font-size: 0.88rem;
    color: var(--gold);
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  .chapter__link:hover {
    color: var(--ink);
  }

  /* ---------- pantalla ---------- */
  .screen {
    position: relative;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--void);
    box-shadow: 0 40px 120px -40px rgba(226, 172, 85, 0.25);
  }
  .screen__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .screen__img--top {
    object-position: top;
  }
  .screen__img--dim {
    filter: brightness(0.55) saturate(0.8);
  }
  .screen--bancor .screen__img[data-view="dia"],
  .screen--bancor .screen__img[data-view="atardecer"] {
    opacity: 0;
  }

  .hud {
    position: absolute;
    left: 0.9rem;
    bottom: 0.9rem;
    max-width: min(88%, 22rem);
    padding: 0.7rem 0.85rem;
    background: rgba(6, 12, 23, 0.82);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.72rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .hud__title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--slate);
    margin-bottom: 0.15rem;
  }
  .hud__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 8px rgba(226, 172, 85, 0.9);
  }
  .hud__line {
    display: flex;
    gap: 0.5rem;
    color: var(--ink);
  }
  .hud__mark {
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    margin-top: 0.3em;
    border: 1px solid var(--gold);
    background: var(--gold);
  }

  /* clearlit */
  .scan,
  .trap {
    display: none;
  }
  .saving {
    position: absolute;
    right: 0.9rem;
    top: 0.9rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.55rem 0.8rem;
    background: rgba(6, 12, 23, 0.86);
    border: 1px solid rgba(226, 172, 85, 0.5);
    border-radius: 6px;
    font-size: clamp(0.85rem, 1.6vw, 1.15rem);
    color: var(--ink);
  }
  .saving__from {
    color: var(--slate);
    text-decoration: line-through;
  }
  .saving__arrow,
  .saving__to {
    color: var(--gold);
    font-weight: 700;
  }
  .saving__unit {
    color: var(--slate);
    font-size: 0.8em;
  }

  /* comolocobro */
  .routes {
    position: absolute;
    right: 0.9rem;
    top: 0.9rem;
    width: min(62%, 22rem);
    padding: 0.8rem 0.9rem;
    background: rgba(6, 12, 23, 0.86);
    border: 1px solid var(--border);
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-size: 0.72rem;
  }
  .route {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    align-items: center;
    gap: 0.6rem;
    color: var(--slate);
    transition:
      color 0.4s ease,
      opacity 0.4s ease;
  }
  .route__bar {
    height: 0.55rem;
    background: var(--border);
    border-radius: 2px;
    overflow: hidden;
  }
  .route__bar span {
    display: block;
    height: 100%;
    width: var(--w);
    background: var(--slate);
  }
  .route--best {
    color: var(--gold);
  }
  .route--best .route__bar span {
    background: var(--gold);
    box-shadow: 0 0 12px rgba(226, 172, 85, 0.8);
  }

  /* =========== capítulos con scroll (JS + movimiento) =========== */
  :global(.has-chapters) .chapter {
    height: 270svh;
    padding: 0;
    border: 0;
  }
  :global(.has-chapters) .chapter__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    display: flex;
    align-items: center;
    padding-block: 5rem 2rem;
    overflow: hidden;
  }
  :global(.has-chapters) .chapter__grid {
    width: 100%;
  }
  /* El texto queda alineado con el resto del sitio; la pantalla se sale hacia la derecha. */
  @media (min-width: 960px) {
    :global(.has-chapters) .chapter__grid {
      grid-template-columns: minmax(0, 4.4fr) minmax(0, 7.6fr);
    }
    :global(.has-chapters) .chapter__visual {
      margin-right: calc(-1 * max(0px, (100vw - var(--maxw)) / 2 - 1.5rem));
    }
  }
  :global(.has-chapters) .screen--bancor .screen__img[data-view="dia"] {
    opacity: 1;
  }
  .chapter__bignum {
    display: none;
  }
  :global(.has-chapters) .chapter__bignum {
    display: block;
    position: absolute;
    right: -2vw;
    top: 50%;
    font-weight: 700;
    font-size: clamp(16rem, 42vw, 40rem);
    line-height: 0.8;
    letter-spacing: -0.08em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(226, 172, 85, 0.13);
    transform: translateY(calc(-50% + (0.5 - var(--p, 0)) * 30vh));
    pointer-events: none;
    user-select: none;
  }

  /* Los tres pasos ocupan la misma celda: la altura la fija el más largo. */
  :global(.has-chapters) .chapter__story {
    display: grid;
    gap: 0;
  }
  :global(.has-chapters) .chapter__step {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.55s var(--ease-out),
      transform 0.55s var(--ease-out);
  }
  :global(.has-chapters) .chapter__body {
    font-size: clamp(1.05rem, 1.7vw, 1.3rem);
    line-height: 1.5;
  }
  :global(.has-chapters) .chapter[data-step="0"] .chapter__step[data-s="0"],
  :global(.has-chapters) .chapter[data-step="1"] .chapter__step[data-s="1"],
  :global(.has-chapters) .chapter[data-step="2"] .chapter__step[data-s="2"] {
    opacity: 1;
    transform: none;
  }

  :global(.has-chapters) .chapter__meter {
    display: flex;
    gap: 0.4rem;
  }
  .chapter__meter span {
    width: 2.6rem;
    height: 2px;
    background: var(--border);
    transition:
      background-color 0.3s ease,
      box-shadow 0.3s ease;
  }
  .chapter[data-step="0"] .chapter__meter [data-m="0"],
  .chapter[data-step="1"] .chapter__meter :is([data-m="0"], [data-m="1"]),
  .chapter[data-step="2"] .chapter__meter span {
    background: var(--gold);
    box-shadow: 0 0 10px rgba(226, 172, 85, 0.7);
  }

  /* La pantalla entra girando y se endereza con el scroll. */
  :global(.has-chapters) .chapter__visual {
    perspective: 1400px;
  }
  :global(.has-chapters) .screen {
    transform: rotateY(calc((0.12 - min(var(--p, 0), 0.12)) * -110deg)) scale(calc(0.94 + min(var(--p, 0), 0.12) * 0.5));
    transform-origin: 30% 50%;
    will-change: transform;
  }
  :global(.has-chapters) .screen__img[data-view] {
    transform: scale(calc(1.14 - var(--p, 0) * 0.14));
  }

  /* HUD: las líneas se encienden por paso. */
  :global(.has-chapters) .hud__line {
    color: var(--slate);
    transition: color 0.3s ease;
  }
  :global(.has-chapters) .hud__mark {
    background: transparent;
    transition:
      background-color 0.3s ease,
      box-shadow 0.3s ease;
  }
  :global(.has-chapters) .chapter[data-step="0"] .hud__line[data-h="0"],
  :global(.has-chapters) .chapter[data-step="1"] .hud__line:is([data-h="0"], [data-h="1"]),
  :global(.has-chapters) .chapter[data-step="2"] .hud__line {
    color: var(--ink);
  }
  :global(.has-chapters) .chapter[data-step="0"] .hud__line[data-h="0"] .hud__mark,
  :global(.has-chapters) .chapter[data-step="1"] .hud__line:is([data-h="0"], [data-h="1"]) .hud__mark,
  :global(.has-chapters) .chapter[data-step="2"] .hud__line .hud__mark {
    background: var(--gold);
    box-shadow: 0 0 8px rgba(226, 172, 85, 0.8);
  }

  /* clearlit: escaneo, trampas y ahorro */
  :global(.has-chapters) .scan {
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    top: calc(min(var(--p, 0) * 1.6, 1) * 100%);
    background: var(--gold);
    box-shadow: 0 0 18px 4px rgba(226, 172, 85, 0.55);
    transition: opacity 0.4s ease;
  }
  :global(.has-chapters) .chapter[data-step="2"] .scan {
    opacity: 0;
  }
  :global(.has-chapters) .trap {
    display: block;
    position: absolute;
    width: 1.1rem;
    height: 1.1rem;
    margin: -0.55rem 0 0 -0.55rem;
    border-radius: 50%;
    background: #E5574A;
    transform: scale(0);
    transition: transform 0.45s var(--ease-out);
    transition-delay: calc(var(--k) * 0.18s);
  }
  :global(.has-chapters) .chapter:is([data-step="1"], [data-step="2"]) .trap {
    transform: scale(1);
    animation: ping 1.6s ease-out infinite;
  }
  @keyframes ping {
    from {
      box-shadow: 0 0 0 0 rgba(229, 87, 74, 0.6);
    }
    to {
      box-shadow: 0 0 0 18px rgba(229, 87, 74, 0);
    }
  }
  :global(.has-chapters) .saving {
    opacity: 0;
    transform: translateY(-10px);
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.5s var(--ease-out);
  }
  :global(.has-chapters) .chapter[data-step="2"] .saving {
    opacity: 1;
    transform: none;
  }

  /* comolocobro: las barras crecen y gana una ruta */
  :global(.has-chapters) .routes {
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  :global(.has-chapters) .chapter:is([data-step="1"], [data-step="2"]) .routes {
    opacity: 1;
  }
  :global(.has-chapters) .route__bar span {
    width: 0;
    transition:
      width 0.9s var(--ease-out),
      background-color 0.4s ease;
    transition-delay: calc(var(--k) * 0.12s);
  }
  :global(.has-chapters) .chapter:is([data-step="1"], [data-step="2"]) .route__bar span {
    width: var(--w);
  }
  :global(.has-chapters) .route--best {
    color: var(--slate);
  }
  :global(.has-chapters) .route--best .route__bar span {
    background: var(--slate);
    box-shadow: none;
  }
  :global(.has-chapters) .chapter[data-step="2"] .route--best {
    color: var(--gold);
  }
  :global(.has-chapters) .chapter[data-step="2"] .route--best .route__bar span {
    background: var(--gold);
    box-shadow: 0 0 12px rgba(226, 172, 85, 0.8);
  }
  :global(.has-chapters) .chapter[data-step="2"] .route:not(.route--best) {
    opacity: 0.45;
  }

  /* Mobile: visual arriba, texto abajo, todo dentro de la pantalla fija. */
  @media (max-width: 959px) {
    :global(.has-chapters) .chapter__stage {
      align-items: flex-start;
      padding-block: 4.5rem 1.25rem;
    }
    :global(.has-chapters) .chapter__grid {
      gap: 1.1rem;
    }
    :global(.has-chapters) .chapter__visual {
      order: -1;
    }
    :global(.has-chapters) .chapter__text {
      gap: 0.6rem;
    }
    :global(.has-chapters) .chapter__name {
      font-size: 2rem;
    }
    :global(.has-chapters) .chapter__tags {
      display: none;
    }
    :global(.has-chapters) .chapter__body {
      font-size: 0.98rem;
    }
    :global(.has-chapters) .screen:not(.screen--bitewave) {
      aspect-ratio: 4 / 3;
    }
    :global(.has-chapters) .chapter__bignum {
      top: auto;
      bottom: 0;
      right: -4vw;
      font-size: 60vw;
      transform: none;
    }
    /* En el celular el registro muestra solo el paso actual. */
    :global(.has-chapters) .hud__title {
      display: none;
    }
    :global(.has-chapters) .hud__line {
      display: none;
    }
    :global(.has-chapters) .chapter[data-step="0"] .hud__line[data-h="0"],
    :global(.has-chapters) .chapter[data-step="1"] .hud__line[data-h="1"],
    :global(.has-chapters) .chapter[data-step="2"] .hud__line[data-h="2"] {
      display: flex;
    }
