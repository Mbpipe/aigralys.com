---
// Franja corta debajo de Bitewave: muestra la amplitud sin competir con los casos.
import { strings, type Lang } from "../i18n/strings";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const a = strings[lang].agro;
---

<aside class="agro" aria-label={a.lead}>
  <div class="container agro__inner" data-reveal>
    <p class="agro__lead mono">{a.lead}</p>
    <ul class="agro__list" role="list">
      {a.items.map((it, i) => <li style={`--i:${i}`}>{it}</li>)}
    </ul>
    <a class="agro__cta mono" href="#contacto">{a.cta}</a>
  </div>
</aside>

<style>
  .agro {
    padding-block: clamp(1.75rem, 4vh, 2.5rem) clamp(3rem, 8vh, 4.5rem);
  }
  .agro__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .agro__lead {
    font-size: 0.85rem;
    color: var(--gold);
  }
  .agro__list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    flex: 1 1 32rem;
  }
  .agro__list li {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: #a9b5c4;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
  }
  .agro__cta {
    font-size: 0.85rem;
    color: var(--gold);
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    white-space: nowrap;
  }
  .agro__cta:hover {
    color: var(--ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .agro__list li {
      opacity: 0;
      transform: translateY(6px);
      transition:
        opacity 0.5s var(--ease-out),
        transform 0.5s var(--ease-out);
      transition-delay: calc(var(--i) * 40ms);
    }
    :global(.js) .agro__inner.is-in li {
      opacity: 1;
      transform: none;
    }
  }
</style>
