---
// Parte un texto en palabras enmascaradas para la animación de entrada.
interface Props {
  text: string;
  as?: "h1" | "h2" | "p";
  class?: string;
  id?: string;
  start?: number;
}
const { text, as: Tag = "h2", class: cls, id, start = 0 } = Astro.props;
const words = text.split(" ");
---

<Tag class:list={["words", cls]} id={id} aria-label={text} data-words>
  {
    words.map((w, i) => (
      <>
        <span class="w" aria-hidden="true" style={`--wi:${i + start}`}>
          <span>{w}</span>
        </span>{" "}
      </>
    ))
  }
</Tag>
