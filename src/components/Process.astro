---
import { strings, type Lang } from "../i18n/strings";
import Words from "./Words.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = strings[lang];
---

<section class="section" id="proceso" aria-labelledby="proceso-title">
  <div class="container">
    <Words text={t.process.heading} class="section__title" id="proceso-title" />
    <ol class="steps" role="list" data-reveal>
      {
        t.process.steps.map((s, i) => (
          <li class="step">
            <span class="step__num mono" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="step__title">{s.title}</h3>
            <p class="step__body">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }
  @media (min-width: 760px) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1.5rem, 4vw, 3rem);
    }
  }

  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding-top: 1.4rem;
  }
  .step::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--border);
  }
  .step::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 1px;
    width: 100%;
    background: var(--gold);
    box-shadow: 0 0 10px rgba(226, 172, 85, 0.6);
    transform-origin: left;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .step::after {
      transform: scaleX(0);
      transition: transform 1s var(--ease-out);
    }
    :global(.js) .step:nth-child(2)::after {
      transition-delay: 0.45s;
    }
    :global(.js) .step:nth-child(3)::after {
      transition-delay: 0.9s;
    }
    :global(.js) .steps.is-in .step::after {
      transform: none;
    }
  }
  .step__num {
    font-weight: 700;
    font-size: clamp(2.8rem, 6vw, 4.6rem);
    line-height: 1;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(226, 172, 85, 0.7);
    margin-bottom: 0.4rem;
  }
  .step__title {
    font-family: var(--mono);
    font-size: clamp(1.2rem, 2.4vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .step__body {
    color: var(--slate);
    max-width: 34ch;
  }
</style>
