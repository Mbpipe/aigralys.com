---
import { strings, type Lang } from "../i18n/strings";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = strings[lang];
const o = t.open;
---

<section class="open" id="posibilidades" aria-labelledby="open-title">
  <div class="container">
    <h2 class="open__title" id="open-title">
      <span class="open__prefix">{o.prefix}</span>
      <span class="open__typed" aria-hidden="true" data-typer data-phrases={JSON.stringify(o.phrases)}
        ><span data-typed>{o.phrases[0]}</span><span class="open__caret"></span></span
      >
      <span class="sr-only">{o.phrases.join(" ")}</span>
    </h2>

    <div class="open__foot">
      <p class="open__body">{o.body}</p>
      <a class="btn btn--primary" href="#contacto">{o.cta}</a>
    </div>
  </div>

</section>

<script>
  const el = document.querySelector<HTMLElement>("[data-typer]");
  if (el && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const out = el.querySelector<HTMLElement>("[data-typed]")!;
    const phrases: string[] = JSON.parse(el.dataset.phrases || "[]");
    let i = 0;
    let started = false;
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

    const run = async () => {
      while (true) {
        const text = phrases[i];
        for (let n = 0; n <= text.length; n++) {
          out.textContent = text.slice(0, n);
          await sleep(28 + Math.random() * 40);
        }
        await sleep(i === phrases.length - 1 ? 3200 : 1700);
        for (let n = text.length; n >= 0; n--) {
          out.textContent = text.slice(0, n);
          await sleep(14);
        }
        await sleep(250);
        i = (i + 1) % phrases.length;
      }
    };

    new IntersectionObserver(([e], obs) => {
      if (e.isIntersecting && !started) {
        started = true;
        obs.disconnect();
        out.textContent = "";
        run();
      }
    }).observe(el);
  }
</script>

<style>
  .open {
    padding-block: clamp(5rem, 14vh, 9rem);
    overflow: hidden;
  }

  .open__title {
    font-family: var(--mono);
    font-weight: 700;
    font-size: clamp(2rem, 6.4vw, 5rem);
    line-height: 1.04;
    letter-spacing: -0.045em;
    color: var(--ink);
    /* Reserva lugar para la frase más larga y evita saltos. */
    min-height: calc(1.04em * 3);
  }

  .open__prefix {
    color: var(--slate);
  }

  .open__typed {
    color: var(--gold);
  }

  .open__caret {
    display: inline-block;
    width: 0.5em;
    height: 0.86em;
    margin-left: 0.08em;
    translate: 0 0.1em;
    background: var(--gold);
    box-shadow: 0 0 24px 2px rgba(226, 172, 85, 0.45);
    animation: blink 1.05s step-end infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .open__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-top: clamp(2rem, 5vh, 3rem);
  }

  .open__body {
    color: #A9B5C4;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    max-width: 52ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .open__caret {
      animation: none;
    }
  }
</style>
