---
import { strings, FORM_ENDPOINT, type Lang } from "../i18n/strings";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = strings[lang];
const c = t.contact;
---

<section class="section" id="contacto" aria-labelledby="contacto-title">
  <div class="container contact">
    <div class="contact__intro">
      <h2 class="section__title" id="contacto-title">{c.heading}</h2>
      <p class="section__intro">{c.lede}</p>
    </div>

    <form
      class="form"
      action={FORM_ENDPOINT}
      method="POST"
      data-contact
      data-sending={c.sending}
      data-ok={c.ok}
      data-error={c.error}
    >
      <input type="hidden" name="_subject" value={c.subject} />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_captcha" value="false" />
      <input type="hidden" name="idioma" value={lang} />
      <input type="hidden" name="origen" value="directo" data-origin />
      <input class="form__honey" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="form__row">
        <label class="field">
          <span class="field__label">{c.name}</span>
          <input class="field__input" type="text" name="nombre" autocomplete="name" required />
        </label>
        <label class="field">
          <span class="field__label">{c.email}</span>
          <input class="field__input" type="email" name="email" autocomplete="email" required />
        </label>
      </div>

      <div class="form__row">
        <label class="field">
          <span class="field__label">{c.company}</span>
          <input class="field__input" type="text" name="empresa" autocomplete="organization" />
        </label>
        <label class="field">
          <span class="field__label">{c.need}</span>
          <select class="field__input" name="necesidad" required>
            {c.needOptions.map((o) => <option value={o}>{o}</option>)}
          </select>
        </label>
      </div>

      <label class="field">
        <span class="field__label">{c.message}</span>
        <textarea class="field__input field__input--area" name="mensaje" rows="5" placeholder={c.messageHint} required
        ></textarea>
      </label>

      <div class="form__actions">
        <button class="btn btn--primary" type="submit">{c.submit}</button>
        <p class="form__status" role="status" aria-live="polite" data-status></p>
      </div>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact]");
  if (form) {
    // Origen del lead: ?utm_source=flama, ?ref=..., o "directo".
    const params = new URLSearchParams(location.search);
    const origin = params.get("utm_source") || params.get("ref");
    const originInput = form.querySelector<HTMLInputElement>("[data-origin]");
    if (origin && originInput) originInput.value = origin.slice(0, 60);

    const status = form.querySelector<HTMLElement>("[data-status]")!;
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const label = button.textContent;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      button.disabled = true;
      button.textContent = form.dataset.sending ?? "…";
      status.textContent = "";
      status.removeAttribute("data-state");
      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || data.success === "false" || data.success === false) throw new Error();
        form.reset();
        status.textContent = form.dataset.ok ?? "";
        status.dataset.state = "ok";
      } catch {
        status.textContent = form.dataset.error ?? "";
        status.dataset.state = "error";
      } finally {
        button.disabled = false;
        button.textContent = label;
      }
    });
  }
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }
  @media (min-width: 900px) {
    .contact {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: clamp(2rem, 5vw, 4rem);
    }
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .form__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.1rem;
  }
  @media (min-width: 620px) {
    .form__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .field__label {
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--slate);
  }
  .field__input {
    font: inherit;
    color: var(--ink);
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.7rem 0.8rem;
    width: 100%;
  }
  .field__input:focus-visible {
    border-color: var(--gold);
    outline-offset: 1px;
  }
  .field__input::placeholder {
    color: #56657a;
  }
  .field__input--area {
    resize: vertical;
    min-height: 8rem;
  }
  select.field__input {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--slate) 50%),
      linear-gradient(135deg, var(--slate) 50%, transparent 50%);
    background-position:
      calc(100% - 1.1rem) 52%,
      calc(100% - 0.75rem) 52%;
    background-size: 0.35rem 0.35rem;
    background-repeat: no-repeat;
    padding-right: 2rem;
  }

  .form__honey {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
  }

  .form__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 0.3rem;
  }
  .form__actions .btn[disabled] {
    opacity: 0.7;
    cursor: progress;
  }

  .form__status {
    font-size: 0.92rem;
    color: var(--slate);
  }
  .form__status[data-state="ok"] {
    color: var(--gold);
  }
  .form__status[data-state="error"] {
    color: #f0a59a;
  }
</style>
