---
import SceneBar from "./SceneBar.astro";

interface Props {
  tasks: string[];
  lang: "es" | "en";
}
const { tasks, lang } = Astro.props;
const es = lang === "es";
const L = es
  ? {
      signal: "vibración / aireador del silo 2",
      classic: "sensor tradicional",
      unit: "mm/s",
      edge: "Bitewave",
      states: ["patrón habitual", "desvío detectado", "patrón distinto"],
      node: "nodo 03",
      model: "modelo en el dispositivo",
      classes: ["normal", "desbalance", "rodamiento", "obstrucción"],
      score: "puntaje de anomalía",
      threshold: "umbral",
      alert: "El patrón de vibración del aireador cambió respecto de su funcionamiento habitual.",
      alertTitle: "aviso al celular",
    }
  : {
      signal: "vibration / silo 2 aerator",
      classic: "traditional sensor",
      unit: "mm/s",
      edge: "Bitewave",
      states: ["usual pattern", "drift detected", "different pattern"],
      node: "node 03",
      model: "on-device model",
      classes: ["normal", "imbalance", "bearing", "blockage"],
      score: "anomaly score",
      threshold: "threshold",
      alert: "The aerator's vibration pattern has changed from its usual behavior.",
      alertTitle: "phone alert",
    };
---

<div class="scene scene--bw" data-scene="bitewave" data-states={JSON.stringify(L.states)}>
  <SceneBar agent="bitewave-edge" tasks={tasks} />

  <div class="bw">
    <div class="bw__signal">
      <p class="bw__label mono">{L.signal}</p>
      <canvas class="bw__wave" data-wave aria-hidden="true"></canvas>
      <div class="bw__read mono" aria-hidden="true">
        <p class="bw__classic"><span>{L.classic}</span><b data-rms>4,2</b> {L.unit}</p>
        <p class="bw__edge"><span>{L.edge}</span><b data-state>{L.states[0]}</b></p>
      </div>
    </div>

    <div class="bw__photo">
      <div class="bw__kb">
        <img src="/work/bitewave-campo.webp" alt="" width="1748" height="560" loading="lazy" decoding="async" />
        <span class="bw__node" data-node>
          <span class="bw__ring"></span><span class="bw__ring bw__ring--2"></span>
          <span class="bw__pin"></span>
        </span>
        <span class="bw__nodelabel mono">{L.node}</span>
      </div>

      <div class="bw__model mono" aria-hidden="true">
        <p class="bw__mtitle">{L.model}</p>
        {
          L.classes.map((c, i) => (
            <p class="bw__cls" data-cls={i}>
              <span>{c}</span>
              <span class="bw__cbar"><span /></span>
              <span class="bw__cval">0.00</span>
            </p>
          ))
        }
      </div>

      <div class="bw__alert" data-alert aria-hidden="true">
        <p class="bw__atitle mono">{L.alertTitle}</p>
        <p>{L.alert}</p>
      </div>
    </div>

    <div class="bw__score">
      <p class="bw__label mono">{L.score} <span class="bw__thr">/ {L.threshold} 0.70</span></p>
      <canvas class="bw__scorec" data-score aria-hidden="true"></canvas>
    </div>
  </div>
</div>

<script>
  // Loop de 16 s: funcionamiento normal → desvío → patrón distinto → aviso.
  const T = 16;
  const hash = (n: number) => {
    const x = Math.sin(n * 127.1) * 43758.5453;
    return x - Math.floor(x);
  };
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  // Cuánto se apartó el patrón de lo habitual (0 normal, 1 distinto).
  const drift = (t: number) => (t < 7 ? 0 : t < 10.5 ? (t - 7) / 3.5 : t < 15 ? 1 : 1 - (t - 15));
  // Vibración: energía parecida, pero cambia la forma (aparece una armónica y un golpeteo).
  const vib = (t: number, i: number) => {
    const d = clamp(drift(t));
    const base = Math.sin(t * 2 * Math.PI * 6) * 0.55;
    const harm = Math.sin(t * 2 * Math.PI * 17 + 1.3) * 0.45 * d;
    const knock = (t * 3) % 1 < 0.06 ? 0.7 * d : 0;
    return base * (1 - 0.25 * d) + harm + knock * Math.sin(t * 300) + (hash(i) - 0.5) * 0.12;
  };
  const score = (t: number) =>
    clamp(0.06 + 0.04 * Math.sin(t * 3) + clamp(drift(t)) * 0.86 + (hash(Math.floor(t * 6)) - 0.5) * 0.04);

  for (const scene of document.querySelectorAll<HTMLElement>('[data-scene="bitewave"]')) {
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const states: string[] = JSON.parse(scene.dataset.states || "[]");
    const wave = scene.querySelector<HTMLCanvasElement>("[data-wave]")!;
    const sc = scene.querySelector<HTMLCanvasElement>("[data-score]")!;
    const wctx = wave.getContext("2d")!;
    const sctx = sc.getContext("2d")!;
    const rmsEl = scene.querySelector<HTMLElement>("[data-rms]")!;
    const stateEl = scene.querySelector<HTMLElement>("[data-state]")!;
    const alertEl = scene.querySelector<HTMLElement>("[data-alert]")!;
    const nodeEl = scene.querySelector<HTMLElement>("[data-node]")!;
    const cls = [...scene.querySelectorAll<HTMLElement>("[data-cls]")];
    const conf = [1, 0, 0, 0];

    const fit = (c: HTMLCanvasElement, ctx: CanvasRenderingContext2D) => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      c.width = Math.max(1, Math.round(c.clientWidth * dpr));
      c.height = Math.max(1, Math.round(c.clientHeight * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    const ro = new ResizeObserver(() => {
      fit(wave, wctx);
      fit(sc, sctx);
    });
    ro.observe(wave);
    ro.observe(sc);

    const draw = (time: number) => {
      const t = (time / 1000) % T;
      const d = clamp(drift(t));
      const level = d < 0.15 ? 0 : d < 0.85 ? 1 : 2;

      // --- vibración en vivo: último 1,2 s ---
      const W = wave.clientWidth,
        H = wave.clientHeight;
      wctx.clearRect(0, 0, W, H);
      const n = Math.max(2, Math.floor(W / 1.5));
      const span = 1.2;
      wctx.lineWidth = 1.3;
      wctx.strokeStyle = level === 2 ? "#F6CD82" : "#E2AC55";
      wctx.shadowColor = "rgba(226, 172, 85, 0.7)";
      wctx.shadowBlur = level === 2 ? 8 : 4;
      wctx.beginPath();
      for (let k = 0; k <= n; k++) {
        const tt = t - span + (k / n) * span;
        const tw = ((tt % T) + T) % T;
        const v = vib(tw, Math.floor(tt * 400));
        const y = H * 0.5 - clamp(v / 1.6, -1, 1) * H * 0.44;
        k ? wctx.lineTo((k / n) * W, y) : wctx.moveTo(0, y);
      }
      wctx.stroke();
      wctx.shadowBlur = 0;

      // El sensor tradicional ve casi el mismo número todo el tiempo.
      rmsEl.textContent = (4.2 + d * 0.3 + (hash(Math.floor(time / 250)) - 0.5) * 0.2).toFixed(1).replace(".", ",");
      stateEl.textContent = states[level];
      stateEl.dataset.level = String(level);
      nodeEl.dataset.level = String(level);
      alertEl.classList.toggle("is-on", t > 10.8 && t < 15.4);

      // --- clasificador ---
      const target = [1 - d * 0.92, d * 0.84, d * 0.1, d * 0.05];
      for (let k = 0; k < 4; k++) {
        conf[k] += (target[k] + (hash(Math.floor(time / 350) + k) - 0.5) * 0.04 - conf[k]) * 0.08;
      }
      const top = conf.indexOf(Math.max(...conf));
      for (let k = 0; k < 4; k++) {
        const v = clamp(conf[k]);
        cls[k].style.setProperty("--v", v.toFixed(3));
        cls[k].querySelector<HTMLElement>(".bw__cval")!.textContent = v.toFixed(2);
        cls[k].classList.toggle("is-top", top === k);
      }

      // --- puntaje de anomalía: últimos ~15 s ---
      const SW = sc.clientWidth,
        SH = sc.clientHeight;
      sctx.clearRect(0, 0, SW, SH);
      const pad = 4;
      const yOf = (v: number) => SH - pad - v * (SH - pad * 2);
      sctx.setLineDash([3, 4]);
      sctx.strokeStyle = "rgba(229, 87, 74, 0.6)";
      sctx.lineWidth = 1;
      sctx.beginPath();
      sctx.moveTo(0, yOf(0.7));
      sctx.lineTo(SW, yOf(0.7));
      sctx.stroke();
      sctx.setLineDash([]);
      const m = Math.max(2, Math.floor(SW / 3));
      const nowX = SW * 0.97;
      sctx.beginPath();
      for (let k = 0; k <= m; k++) {
        const x = (k / m) * nowX;
        const tt = t - (1 - k / m) * T * 0.95;
        const v = score(((tt % T) + T) % T);
        k ? sctx.lineTo(x, yOf(v)) : sctx.moveTo(x, yOf(v));
      }
      const grad = sctx.createLinearGradient(0, yOf(1), 0, yOf(0));
      grad.addColorStop(0, "#E5574A");
      grad.addColorStop(0.35, "#E2AC55");
      grad.addColorStop(1, "#5BD08A");
      sctx.strokeStyle = grad;
      sctx.lineWidth = 2;
      sctx.stroke();
      sctx.fillStyle = "#F4F3EF";
      sctx.beginPath();
      sctx.arc(nowX, yOf(score(t)), 3.5, 0, Math.PI * 2);
      sctx.fill();

      if (running) raf = requestAnimationFrame(draw);
    };

    let running = false;
    let raf = 0;
    if (still) {
      requestAnimationFrame(() => {
        fit(wave, wctx);
        fit(sc, sctx);
        draw(12500);
      });
    } else {
      new IntersectionObserver(([e]) => {
        running = e.isIntersecting;
        cancelAnimationFrame(raf);
        if (running) raf = requestAnimationFrame(draw);
      }).observe(scene);
    }
  }
</script>

<style>
  .scene--bw {
    background: #070d18;
  }
  .bw {
    position: absolute;
    inset: 7.2cqw 0 0 0;
    display: grid;
    grid-template-rows: 21% minmax(0, 1fr) 20%;
    font-size: clamp(7px, 1.08cqw, 12px);
  }
  .bw__label {
    color: var(--slate);
    font-size: 0.9em;
  }

  /* vibración + lectura comparada */
  .bw__signal {
    position: relative;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto minmax(0, 1fr);
    column-gap: 1.6cqw;
    padding: 0.8cqw 1.6cqw 0.6cqw;
  }
  .bw__signal .bw__label {
    grid-column: 1;
  }
  .bw__wave,
  .bw__scorec {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
  }
  .bw__wave {
    grid-column: 1;
    grid-row: 2;
  }
  .bw__read {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    display: flex;
    flex-direction: column;
    gap: 0.5em;
    min-width: 17em;
  }
  .bw__read p {
    display: flex;
    align-items: baseline;
    gap: 0.6em;
    color: var(--slate);
  }
  .bw__read span {
    font-size: 0.9em;
    margin-right: auto;
  }
  .bw__classic b {
    color: var(--ink);
    font-weight: 500;
    font-size: 1.3em;
    font-variant-numeric: tabular-nums;
  }
  .bw__edge b {
    font-weight: 600;
    font-size: 1.05em;
    color: #5bd08a;
    transition: color 0.3s ease;
  }
  .bw__edge b[data-level="1"] {
    color: var(--gold);
  }
  .bw__edge b[data-level="2"] {
    color: #f2a097;
  }

  /* foto del campo */
  .bw__photo {
    position: relative;
    overflow: hidden;
    border-block: 1px solid var(--border);
  }
  .bw__kb {
    position: absolute;
    inset: 0;
    animation: kenburns 20s ease-in-out infinite alternate;
    transform-origin: 80% 40%;
  }
  .bw__kb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @keyframes kenburns {
    from {
      transform: scale(1.02);
    }
    to {
      transform: scale(1.1);
    }
  }

  .bw__node {
    position: absolute;
    left: 80.6%;
    top: 42%;
  }
  .bw__pin {
    position: absolute;
    width: 0.9cqw;
    height: 0.9cqw;
    min-width: 7px;
    min-height: 7px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: #5bd08a;
    box-shadow: 0 0 10px rgba(91, 208, 138, 0.9);
    transition:
      background-color 0.3s ease,
      box-shadow 0.3s ease;
  }
  .bw__ring {
    position: absolute;
    width: 5cqw;
    height: 5cqw;
    transform: translate(-50%, -50%) scale(0.2);
    border-radius: 50%;
    border: 1.5px solid #5bd08a;
    animation: ring 2.4s ease-out infinite;
  }
  .bw__ring--2 {
    animation-delay: 1.2s;
  }
  .bw__node[data-level="1"] .bw__pin {
    background: var(--gold);
    box-shadow: 0 0 10px rgba(226, 172, 85, 0.9);
  }
  .bw__node[data-level="1"] .bw__ring {
    border-color: var(--gold);
  }
  .bw__node[data-level="2"] .bw__pin {
    background: #e5574a;
    box-shadow: 0 0 14px rgba(229, 87, 74, 0.95);
  }
  .bw__node[data-level="2"] .bw__ring {
    border-color: #e5574a;
    animation-duration: 1.1s;
  }
  @keyframes ring {
    from {
      opacity: 1;
      transform: translate(-50%, -50%) scale(0.2);
    }
    to {
      opacity: 0;
      transform: translate(-50%, -50%) scale(1.6);
    }
  }
  .bw__nodelabel {
    position: absolute;
    left: 80.6%;
    top: 42%;
    transform: translate(-115%, -50%);
    padding: 0.15em 0.5em;
    font-size: 0.85em;
    color: var(--ink);
    background: rgba(6, 12, 23, 0.75);
    border: 1px solid var(--border);
    border-radius: 3px;
    white-space: nowrap;
  }

  .bw__model {
    position: absolute;
    left: 1.6cqw;
    bottom: 1.2cqw;
    width: 25cqw;
    min-width: 130px;
    padding: 0.9em 1em;
    background: rgba(6, 12, 23, 0.86);
    border: 1px solid var(--border);
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: 0.45em;
  }
  .bw__mtitle {
    color: var(--gold);
    margin-bottom: 0.15em;
  }
  .bw__cls {
    display: grid;
    grid-template-columns: 6.5em 1fr 2.6em;
    align-items: center;
    gap: 0.6em;
    color: var(--slate);
  }
  .bw__cbar {
    height: 0.45em;
    background: var(--border);
    border-radius: 2px;
    overflow: hidden;
  }
  .bw__cbar span {
    display: block;
    height: 100%;
    width: calc(var(--v, 0) * 100%);
    background: var(--slate);
  }
  .bw__cval {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .bw__cls.is-top {
    color: var(--ink);
  }
  .bw__cls.is-top .bw__cbar span {
    background: var(--gold);
    box-shadow: 0 0 8px rgba(226, 172, 85, 0.8);
  }

  .bw__alert {
    position: absolute;
    right: 1.6cqw;
    bottom: 1.2cqw;
    width: 36cqw;
    padding: 0.9em 1.1em;
    background: rgba(6, 12, 23, 0.9);
    border: 1px solid rgba(229, 87, 74, 0.7);
    border-left: 3px solid #e5574a;
    border-radius: 6px;
    color: var(--ink);
    box-shadow: 0 10px 40px -10px rgba(229, 87, 74, 0.5);
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.4s var(--ease-out),
      transform 0.4s var(--ease-out);
  }
  .bw__alert.is-on {
    opacity: 1;
    transform: none;
  }
  .bw__atitle {
    color: #f2a097;
    font-size: 0.9em;
    margin-bottom: 0.3em;
  }

  /* puntaje de anomalía */
  .bw__score {
    min-height: 0;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 0.3em;
    padding: 0.7cqw 1.6cqw 0.8cqw;
  }
  .bw__thr {
    color: #f2a097;
  }

  @container (max-width: 520px) {
    .bw__read {
      min-width: 0;
    }
    .bw__read span,
    .bw__label,
    .bw__model,
    .bw__nodelabel {
      display: none;
    }
    .bw__alert {
      left: 1.6cqw;
      width: auto;
      padding: 0.5em 0.7em;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bw__kb,
    .bw__ring {
      animation: none;
    }
  }
</style>
