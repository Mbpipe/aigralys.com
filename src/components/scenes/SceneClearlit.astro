---
import SceneBar from "./SceneBar.astro";

interface Props {
  tasks: string[];
  lang: "es" | "en";
}
const { tasks, lang } = Astro.props;
const es = lang === "es";

const files = [
  { d: 0, n: "src/" },
  { d: 1, n: "pages/feed.tsx", flag: 1 },
  { d: 1, n: "lib/supabase.ts" },
  { d: 1, n: "components/Gallery.tsx", flag: 2 },
  { d: 0, n: "supabase/" },
  { d: 1, n: "functions/sync-orders/" },
  { d: 1, n: "migrations/0004_orders.sql" },
  { d: 0, n: "storage/uploads/" },
  { d: 0, n: "lovable.config.json", flag: 0 },
  { d: 0, n: "package.json" },
];
const findings = es
  ? [
      { t: "Backend en Lovable Cloud", d: "+ USD 725 / mes a 25 mil usuarios", s: "alto" },
      { t: "Query sin límite en /feed", d: "lee la tabla entera en cada visita", s: "alto" },
      { t: "Imágenes sin CDN", d: "USD 0,09 por GB fuera del free tier", s: "medio" },
    ]
  : [
      { t: "Backend on Lovable Cloud", d: "+ USD 725 / mo at 25k users", s: "high" },
      { t: "Unbounded query on /feed", d: "reads the whole table every visit", s: "high" },
      { t: "Images without a CDN", d: "USD 0.09 per GB past the free tier", s: "med" },
    ];
const fix = "Move my backend off Lovable Cloud to my own Supabase project, keeping the same schema and auth.";
const L = es
  ? { files: "archivos", chart: "costo mensual proyectado", now: "hoy", after: "con los arreglos", users: "usuarios", fix: "arreglo" }
  : { files: "files", chart: "projected monthly cost", now: "today", after: "with the fixes", users: "users", fix: "fix" };

// Curvas de costo (SVG 400×200): hoy crece fuerte, con arreglos queda plana.
const xs = [0, 0.1, 0.2, 0.35, 0.5, 0.7, 0.85, 1];
const users = [0, 1, 2, 5, 10, 25, 40, 50];
const costNow = users.map((u) => 5 + Math.pow(u, 1.55) * 5);
const costFix = users.map((u) => 5 + u * 2.8);
const maxC = Math.max(...costNow) * 1.05;
const toPath = (arr: number[]) =>
  arr.map((c, i) => `${i ? "L" : "M"}${(30 + xs[i] * 360).toFixed(1)},${(180 - (c / maxC) * 160).toFixed(1)}`).join(" ");
const pNow = toPath(costNow);
const pFix = toPath(costFix);
const i25 = 5;
const yNow = 180 - (costNow[i25] / maxC) * 160;
const yFix = 180 - (costFix[i25] / maxC) * 160;
const x25 = 30 + xs[i25] * 360;
---

<div class="scene scene--clearlit" data-scene="clearlit">
  <SceneBar agent="cost-agent" tasks={tasks} />

  <div class="cl">
    <aside class="cl__tree mono" aria-hidden="true">
      <p class="cl__h">{L.files}</p>
      <ul>
        <li class="cl__cursor" aria-hidden="true"></li>
        {
          files.map((f, i) => (
            <li class:list={["cl__file", { "cl__file--flag": f.flag !== undefined }]} style={`--d:${f.d};--i:${i}`} data-flag={f.flag}>
              {f.n}
            </li>
          ))
        }
      </ul>
    </aside>

    <div class="cl__main">
      <div class="cl__chart">
        <p class="cl__h mono">{L.chart}</p>
        <svg viewBox="0 0 400 200" preserveAspectRatio="none" aria-hidden="true">
          {[0, 1, 2, 3].map((k) => <line class="cl__grid" x1="30" x2="390" y1={20 + k * 53.3} y2={20 + k * 53.3} />)}
          <path class="cl__now" d={pNow} pathLength="1" />
          <path class="cl__fix" d={pFix} pathLength="1" />
          <line class="cl__mark" x1={x25} x2={x25} y1="20" y2="180" />
          <circle class="cl__dot cl__dot--now" cx={x25} cy={yNow} r="4" />
          <circle class="cl__dot cl__dot--fix" cx={x25} cy={yFix} r="4" />
          <text class="cl__ax mono" x="30" y="196">1k</text>
          <text class="cl__ax mono" x={x25 - 8} y="196">25k {L.users}</text>
          <text class="cl__ax mono" x="372" y="196">50k</text>
        </svg>
        <span class="cl__tag cl__tag--now mono" style={`left:${(x25 / 400) * 100}%;top:${(yNow / 200) * 100}%`}>{L.now} ≈ USD 800</span>
        <span class="cl__tag cl__tag--fix mono" style={`left:${(x25 / 400) * 100}%;top:${(yFix / 200) * 100}%`}>{L.after} ≈ USD 75</span>
      </div>

      <ul class="cl__findings" aria-hidden="true">
        {
          findings.map((f, k) => (
            <li class="cl__card" style={`--k:${k}`}>
              <span class:list={["cl__sev mono", { "cl__sev--hi": k < 2 }]}>{f.s}</span>
              <b>{f.t}</b>
              <span class="cl__d">{f.d}</span>
            </li>
          ))
        }
      </ul>

      <div class="cl__fixbox mono" aria-hidden="true">
        <span class="cl__fixlabel">{L.fix} →</span>
        <span data-type={fix}></span><span class="cl__caret"></span>
      </div>
    </div>
  </div>
</div>

<script>
  // Tipeo del arreglo en loop mientras la escena está a la vista.
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  for (const scene of document.querySelectorAll<HTMLElement>('[data-scene="clearlit"]')) {
    const out = scene.querySelector<HTMLElement>("[data-type]")!;
    const text = out.dataset.type || "";
    if (still) {
      out.textContent = text;
      continue;
    }
    let visible = false;
    let n = 0;
    let hold = 0;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(scene);
    setInterval(() => {
      if (!visible) return;
      if (n <= text.length) {
        out.textContent = text.slice(0, n);
        n += 1;
      } else if (++hold > 60) {
        n = 0;
        hold = 0;
      }
    }, 38);
  }
</script>

<style>
  .scene--clearlit {
    background:
      radial-gradient(ellipse at 70% 0%, rgba(226, 172, 85, 0.08), transparent 60%),
      #0A1322;
  }
  .cl {
    position: absolute;
    inset: 7.2cqw 0 0 0;
    display: grid;
    grid-template-columns: 30% 1fr;
    font-size: clamp(7px, 1.1cqw, 12px);
  }
  .cl__h {
    font-size: 0.9em;
    color: var(--slate);
    margin-bottom: 0.8em;
  }

  /* árbol de archivos */
  .cl__tree {
    position: relative;
    padding: 1.6cqw 1.4cqw;
    border-right: 1px solid var(--border);
    overflow: hidden;
  }
  .cl__tree ul {
    position: relative;
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .cl__tree li {
    line-height: 2;
  }
  .cl__file {
    position: relative;
    padding-left: calc(var(--d) * 1.4em);
    color: #8FA0B5;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cl__file--flag::after {
    content: "";
    position: absolute;
    right: 0;
    top: 50%;
    width: 0.6em;
    height: 0.6em;
    margin-top: -0.3em;
    border-radius: 50%;
    background: #E5574A;
    transform: scale(0);
    transition: transform 0.4s var(--ease-out);
  }
  :global(.chapter:is([data-step="1"], [data-step="2"])) .cl__file--flag {
    color: var(--ink);
  }
  :global(.chapter:is([data-step="1"], [data-step="2"])) .cl__file--flag::after {
    transform: scale(1);
    box-shadow: 0 0 8px rgba(229, 87, 74, 0.8);
  }
  .cl__cursor {
    position: absolute;
    left: -1.4cqw;
    right: -1.4cqw;
    top: 0;
    height: 10%;
    background: linear-gradient(90deg, rgba(226, 172, 85, 0.22), rgba(226, 172, 85, 0.04));
    border-left: 2px solid var(--gold);
    animation: scan 3.2s steps(10) infinite;
  }
  @keyframes scan {
    to {
      transform: translateY(1000%);
    }
  }

  /* gráfico */
  .cl__main {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto auto;
    gap: 1.2cqw;
    padding: 1.6cqw 1.8cqw;
    min-width: 0;
  }
  .cl__chart {
    position: relative;
    min-height: 0;
  }
  .cl__chart svg {
    position: absolute;
    inset: 1.8em 0 0 0;
    width: 100%;
    height: calc(100% - 1.8em);
    overflow: visible;
  }
  .cl__grid {
    stroke: var(--border);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .cl__now,
  .cl__fix {
    fill: none;
    stroke-width: 2.5;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.6s var(--ease-out);
  }
  .cl__now {
    stroke: #E5574A;
  }
  .cl__fix {
    stroke: var(--gold);
    filter: drop-shadow(0 0 4px rgba(226, 172, 85, 0.8));
  }
  :global(.chapter:is([data-step="1"], [data-step="2"])) .cl__now,
  :global(.chapter[data-step="2"]) .cl__fix {
    stroke-dashoffset: 0;
  }
  .cl__mark {
    stroke: var(--slate);
    stroke-dasharray: 3 4;
    vector-effect: non-scaling-stroke;
  }
  .cl__dot {
    opacity: 0;
    transition: opacity 0.4s ease 1s;
  }
  .cl__dot--now {
    fill: #E5574A;
  }
  .cl__dot--fix {
    fill: var(--gold);
  }
  :global(.chapter:is([data-step="1"], [data-step="2"])) .cl__dot--now,
  :global(.chapter[data-step="2"]) .cl__dot--fix {
    opacity: 1;
  }
  .cl__ax {
    font-size: 9px;
    fill: var(--slate);
  }
  .cl__tag {
    position: absolute;
    transform: translate(-105%, calc(1.8em - 130%));
    padding: 0.25em 0.6em;
    border-radius: 3px;
    font-size: 0.95em;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.4s ease 1.1s;
  }
  .cl__tag--now {
    background: rgba(229, 87, 74, 0.16);
    color: #F2A097;
    border: 1px solid rgba(229, 87, 74, 0.5);
  }
  .cl__tag--fix {
    background: rgba(226, 172, 85, 0.14);
    color: var(--gold);
    border: 1px solid rgba(226, 172, 85, 0.5);
  }
  :global(.chapter:is([data-step="1"], [data-step="2"])) .cl__tag--now,
  :global(.chapter[data-step="2"]) .cl__tag--fix {
    opacity: 1;
  }

  /* hallazgos */
  .cl__findings {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8cqw;
  }
  .cl__card {
    display: flex;
    flex-direction: column;
    gap: 0.3em;
    padding: 0.8em 0.9em;
    background: rgba(6, 12, 23, 0.7);
    border: 1px solid var(--border);
    border-radius: 5px;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.45s var(--ease-out),
      transform 0.45s var(--ease-out);
    transition-delay: calc(0.2s + var(--k) * 0.18s);
  }
  :global(.chapter:is([data-step="1"], [data-step="2"])) .cl__card {
    opacity: 1;
    transform: none;
  }
  .cl__card b {
    color: var(--ink);
    font-weight: 600;
  }
  .cl__d {
    color: var(--slate);
  }
  .cl__sev {
    align-self: flex-start;
    font-size: 0.85em;
    padding: 0.05em 0.45em;
    border-radius: 3px;
    color: var(--gold);
    border: 1px solid rgba(226, 172, 85, 0.5);
  }
  .cl__sev--hi {
    color: #F2A097;
    border-color: rgba(229, 87, 74, 0.6);
  }

  /* arreglo */
  .cl__fixbox {
    padding: 0.7em 0.9em;
    border: 1px dashed rgba(226, 172, 85, 0.55);
    border-radius: 5px;
    color: var(--ink);
    background: rgba(226, 172, 85, 0.05);
    min-height: 3.6em;
    opacity: 0.25;
    transition: opacity 0.4s ease;
  }
  :global(.chapter[data-step="2"]) .cl__fixbox {
    opacity: 1;
  }
  .cl__fixlabel {
    color: var(--gold);
    margin-right: 0.6em;
  }
  .cl__caret {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    margin-left: 0.1em;
    vertical-align: -0.15em;
    background: var(--gold);
    animation: blinkc 1s step-end infinite;
  }
  @keyframes blinkc {
    50% {
      opacity: 0;
    }
  }

  @container (max-width: 520px) {
    .cl {
      grid-template-columns: 1fr;
    }
    .cl__tree,
    .cl__fixbox {
      display: none;
    }
    .cl__findings {
      grid-template-columns: 1fr 1fr;
    }
    .cl__card:nth-child(3) {
      display: none;
    }
    .cl__card .cl__d {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cl__cursor,
    .cl__caret {
      animation: none;
    }
  }
</style>
