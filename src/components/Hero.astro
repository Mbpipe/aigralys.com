---
import { strings, type Lang } from "../i18n/strings";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = strings[lang];
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      <h1 class="hero__title">{t.hero.title}</h1>
      <p class="hero__lede">{t.hero.lede}</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="#contacto">{t.hero.ctaContact}</a>
        <a class="btn btn--ghost" href="#casos">{t.hero.ctaCases}</a>
      </div>
      <p class="hero__sig mono">
        <span class="muted">//</span> build <span class="gold">→</span> ship
        <span class="gold">→</span> repeat.
      </p>
    </div>

    <figure class="session" aria-label={t.hero.caption}>
      <div class="session__bar mono">
        <span class="session__dot" aria-hidden="true"></span>
        {t.hero.session}
      </div>
      <ol class="session__log mono" role="list">
        {
          t.hero.log.map((line, i) => (
            <li class="session__line" style={`--i:${i}`}>
              <span class="session__mark" aria-hidden="true">{i === 0 ? ">" : "✓"}</span>
              {line}
            </li>
          ))
        }
      </ol>
      <div class="session__render" style={`--i:${t.hero.log.length}`}>
        <img
          src="/work/bancor-noche.webp"
          alt=""
          width="1800"
          height="1013"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <figcaption class="session__caption">{t.hero.caption}</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(6.5rem, 16vh, 9rem) clamp(3.5rem, 9vh, 6rem);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      min-height: calc(100svh - 14rem);
    }
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .hero__title {
    font-family: var(--mono);
    font-weight: 700;
    font-size: clamp(2rem, 5.2vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--ink);
    max-width: 18ch;
    text-wrap: balance;
  }

  .hero__lede {
    font-size: clamp(1.05rem, 2.2vw, 1.2rem);
    color: var(--slate);
    max-width: 48ch;
    line-height: 1.6;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .hero__sig {
    font-size: 0.9rem;
    color: var(--ink);
    margin-top: 0.5rem;
  }

  /* ---------- sesión del agente ---------- */
  .session {
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--panel);
    overflow: hidden;
  }

  .session__bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1rem;
    font-size: 0.78rem;
    color: var(--slate);
    border-bottom: 1px solid var(--border);
  }

  .session__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--gold);
  }

  .session__log {
    list-style: none;
    padding: 1rem 1rem 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: clamp(0.76rem, 1.6vw, 0.84rem);
    color: var(--ink);
  }

  .session__line {
    display: flex;
    gap: 0.6rem;
  }

  .session__mark {
    color: var(--gold);
    flex: none;
    width: 1ch;
  }

  .session__render {
    border-top: 1px solid var(--border);
    aspect-ratio: 1800 / 1013;
    background: var(--navy);
  }
  .session__render img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .session__caption {
    padding: 0.7rem 1rem;
    font-size: 0.8rem;
    color: var(--slate);
    border-top: 1px solid var(--border);
  }

  /* Un solo momento de movimiento: el agente "trabaja" al cargar. */
  @media (prefers-reduced-motion: no-preference) {
    .session__line,
    .session__render {
      opacity: 0;
      animation: step 0.35s ease forwards;
      animation-delay: calc(0.35s + var(--i) * 0.55s);
    }
    .session__render {
      animation-duration: 0.8s;
    }
  }

  @keyframes step {
    to {
      opacity: 1;
    }
  }
</style>
