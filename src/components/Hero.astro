---
import { strings, type Lang } from "../i18n/strings";
import Words from "./Words.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = strings[lang];
---

<section class="hero">
  <canvas class="hero__field" aria-hidden="true" data-field></canvas>

  <div class="container hero__inner">
    <Words as="h1" class="hero__title is-in" text={t.hero.title} />
    <p class="hero__lede">{t.hero.lede}</p>
    <div class="hero__cta">
      <a class="btn btn--primary" href="#contacto">{t.hero.ctaContact}</a>
      <a class="btn btn--ghost" href="#casos">{t.hero.ctaCases}</a>
    </div>
  </div>

  <div class="container hero__foot mono" aria-hidden="true">
    <span><span class="muted">//</span> build <span class="gold">→</span> ship <span class="gold">→</span> repeat.</span>
    <span class="hero__scroll">{t.hero.scroll} <span class="hero__scroll-bar"></span></span>
  </div>
</section>

<script>
  // Campo de señal: una malla de puntos en perspectiva que ondula como una señal.
  // Reacciona al puntero y emite pulsos, como eventos detectados por un modelo.
  const canvas = document.querySelector<HTMLCanvasElement>("[data-field]");
  if (canvas) {
    const ctx = canvas.getContext("2d")!;
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const COLS = 84;
    const ROWS = 44;
    let w = 0,
      h = 0,
      dpr = 1,
      running = true,
      raf = 0;
    const mouse = { x: 0.62, y: 0.6, tx: 0.62, ty: 0.6 };
    const pulses: { x: number; z: number; t0: number }[] = [];
    let lastPulse = 0;

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const BUCKETS = 7;
    const buckets: number[][] = Array.from({ length: BUCKETS }, () => []);

    const frame = (ms: number) => {
      const t = ms / 1000;
      mouse.x += (mouse.tx - mouse.x) * 0.06;
      mouse.y += (mouse.ty - mouse.y) * 0.06;

      if (!still && t - lastPulse > 2.4) {
        lastPulse = t;
        pulses.push({ x: Math.random() * 2 - 1, z: 0.2 + Math.random() * 0.7, t0: t });
        if (pulses.length > 4) pulses.shift();
      }

      ctx.clearRect(0, 0, w, h);
      for (const b of buckets) b.length = 0;

      const horizon = h * 0.3;
      const f = Math.max(w, h) * 0.55;
      const camH = 1.15;
      const mx = mouse.x * 2 - 1;
      const mz = 1 - mouse.y;

      for (let r = 0; r < ROWS; r++) {
        const zn = r / (ROWS - 1); // 0 lejos, 1 cerca
        const depth = 5.2 - zn * 4.2;
        for (let c = 0; c < COLS; c++) {
          const xn = (c / (COLS - 1)) * 2 - 1;
          const xw = xn * 3.2;
          let y =
            0.22 * Math.sin(xw * 1.3 + t * 0.7) * Math.cos(zn * 4 - t * 0.5) +
            0.1 * Math.sin((xw + zn * 6) * 2.1 - t * 1.3);
          const dx = xn - mx,
            dz = zn - mz;
          const dm = Math.sqrt(dx * dx * 2 + dz * dz * 3);
          y += 0.35 * Math.exp(-dm * dm * 3) * Math.sin(dm * 14 - t * 5);
          let glow = 0;
          for (const p of pulses) {
            const age = t - p.t0;
            const d = Math.hypot((xn - p.x) * 1.4, (zn - p.z) * 2.2);
            const ring = Math.exp(-Math.pow((d - age * 0.55) * 7, 2)) * Math.max(0, 1 - age / 3.5);
            y += ring * 0.28;
            glow = Math.max(glow, ring);
          }
          const sx = w * 0.5 + (xw * f) / depth;
          if (sx < -10 || sx > w + 10) continue;
          const sy = horizon + ((camH - y) * f) / depth * 0.62;
          const near = zn * zn;
          const level = Math.min(BUCKETS - 1, Math.floor((0.15 + near * 0.55 + glow * 0.6 + Math.max(0, y) * 0.5) * BUCKETS));
          const b = buckets[level];
          const size = 0.8 + near * 2.2 + glow * 2;
          b.push(sx, sy, size);
        }
      }

      for (let i = 0; i < BUCKETS; i++) {
        const b = buckets[i];
        const a = 0.14 + (i / (BUCKETS - 1)) * 0.86;
        ctx.fillStyle = i >= BUCKETS - 2 ? `rgba(246, 205, 130, ${a})` : `rgba(226, 172, 85, ${a})`;
        for (let k = 0; k < b.length; k += 3) {
          const s = b[k + 2];
          ctx.fillRect(b[k] - s / 2, b[k + 1] - s / 2, s, s);
        }
      }

      if (running && !still) raf = requestAnimationFrame(frame);
    };

    resize();
    addEventListener("resize", resize);
    addEventListener(
      "pointermove",
      (e) => {
        mouse.tx = e.clientX / innerWidth;
        mouse.ty = Math.min(1, Math.max(0.3, e.clientY / innerHeight));
      },
      { passive: true },
    );

    new IntersectionObserver(([entry]) => {
      running = entry.isIntersecting;
      cancelAnimationFrame(raf);
      if (running) raf = requestAnimationFrame(frame);
    }).observe(canvas);

    raf = requestAnimationFrame(frame);
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 7rem 2rem;
    background: var(--void);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }

  /* Velo para que el texto siempre se lea sobre el campo. */
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 60% 50% at 20% 48%, rgba(6, 12, 23, 0.85), rgba(6, 12, 23, 0) 72%),
      linear-gradient(to bottom, rgba(6, 12, 23, 0) 70%, var(--navy) 100%);
    pointer-events: none;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    flex: 1;
    justify-content: center;
  }

  .hero :global(.hero__title) {
    font-family: var(--mono);
    font-weight: 700;
    font-size: clamp(2.4rem, 6.6vw, 5.4rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
    color: var(--ink);
    max-width: 17ch;
  }

  .hero__lede {
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    color: #A9B5C4;
    max-width: 46ch;
    line-height: 1.6;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-size: 0.82rem;
    color: var(--ink);
    padding-top: 2.5rem;
  }

  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--slate);
  }
  .hero__scroll-bar {
    position: relative;
    width: 1px;
    height: 2.5rem;
    background: var(--border);
    overflow: hidden;
  }
  .hero__scroll-bar::after {
    content: "";
    position: absolute;
    left: 0;
    width: 1px;
    height: 40%;
    background: var(--gold);
    animation: drip 1.8s var(--ease-out) infinite;
  }
  @keyframes drip {
    from {
      top: -40%;
    }
    to {
      top: 100%;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__lede,
    .hero__cta,
    .hero__foot {
      opacity: 0;
      animation: rise 1s var(--ease-out) forwards;
    }
    .hero__lede {
      animation-delay: 0.55s;
    }
    .hero__cta {
      animation-delay: 0.7s;
    }
    .hero__foot {
      animation-delay: 1s;
    }
    /* El título ya llega con .is-in: entra al cargar. */
    .hero__title :global(.w > span) {
      animation: wordUp 1s var(--ease-out) both;
      animation-delay: calc(0.1s + var(--wi) * 70ms);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-bar::after {
      animation: none;
      top: 30%;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes wordUp {
    from {
      transform: translateY(105%);
    }
    to {
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .hero__scroll {
      display: none;
    }
  }
</style>
