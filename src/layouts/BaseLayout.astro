---
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/jetbrains-mono/700.css";
import "../styles/global.css";
import LangSwitcher from "../components/LangSwitcher.astro";
import { strings, localeTag, localeHref, type Lang } from "../i18n/strings";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings[lang];

const site = "https://aigralys.com";
const canonical = lang === "es" ? `${site}/` : `${site}/en/`;
const ogImage = `${site}/og.png`;
---

<!doctype html>
<html lang={localeTag[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#060C17" />
    <script is:inline>document.documentElement.classList.add("js");</script>

    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />

    <!-- hreflang: ES / EN / x-default -->
    <link rel="alternate" hreflang="es" href={`${site}/`} />
    <link rel="alternate" hreflang="en" href={`${site}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/`} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "Aigralys",
        url: site,
        logo: `${site}/favicon.svg`,
        image: ogImage,
        email: "hello@aigralys.com",
        description: t.meta.description,
        sameAs: ["https://x.com/Aigralys"],
        knowsAbout: ["AI agents", "AI consulting", "digital products", "generative video", "IoT", "MCP"],
      })}
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="aigralys" />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "es_AR"} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImage} />

  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipToContent}</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__mark mono" href={localeHref[lang]}
          >aigralys<span class="site-header__cursor" aria-hidden="true"></span></a
        >
        <nav class="site-nav mono" aria-label="Principal">
          <a class="site-nav__link" href="#posibilidades">{t.nav.open}</a>
          <a class="site-nav__link" href="#casos">{t.nav.cases}</a>
          <a class="site-nav__link site-nav__link--cta" href="#contacto">{t.nav.contact}</a>
          <LangSwitcher lang={lang} />
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <script>
      // Header: se vuelve sólido al bajar.
      const header = document.querySelector<HTMLElement>(".site-header");
      const onScroll = () => header?.classList.toggle("is-scrolled", scrollY > 40);
      addEventListener("scroll", onScroll, { passive: true });
      onScroll();

      // Revelado al entrar en pantalla (títulos y bloques marcados).
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -12% 0px" },
      );
      document.querySelectorAll("[data-words]:not(.is-in), [data-reveal]").forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 10;
    background: var(--gold);
    color: var(--navy);
    padding: 0.5rem 0.9rem;
    font-family: var(--mono);
    font-size: 0.85rem;
    border-radius: 0 0 4px 0;
  }
  .skip-link:focus {
    left: 0;
  }

  .site-header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 20;
    padding-block: clamp(1rem, 3vh, 1.4rem);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      padding 0.3s ease;
  }
  .site-header.is-scrolled {
    background: rgba(6, 12, 23, 0.72);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    border-bottom-color: var(--border);
    padding-block: 0.8rem;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-header__mark {
    display: inline-flex;
    align-items: center;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .site-header__cursor {
    display: inline-block;
    width: 0.5em;
    height: 0.9em;
    margin-left: 0.12em;
    background: var(--gold);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2.5vw, 1.75rem);
    font-size: 0.85rem;
  }
  .site-nav__link {
    color: var(--slate);
    transition: color 0.15s ease;
  }
  .site-nav__link:hover {
    color: var(--ink);
  }
  .site-nav__link--cta {
    color: var(--gold);
  }

  @media (max-width: 640px) {
    .site-nav__link:not(.site-nav__link--cta) {
      display: none;
    }
  }
</style>
